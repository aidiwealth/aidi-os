# Aidi OS — copy to .env for local development. Production values live in App Platform secrets.
NUXT_DATABASE_URL=postgres://user:pass@localhost:5432/aidi_os?sslmode=disable
NUXT_DATABASE_CA=
NUXT_ANTHROPIC_API_KEY=
NUXT_JWT_SECRET=          # 32+ random characters: openssl rand -base64 48
NUXT_RESEND_API_KEY=
NUXT_PUBLIC_APP_BASE_URL=http://localhost:3000
